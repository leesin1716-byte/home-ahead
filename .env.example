# Copy to .env (npm start and npm run demo read it). Every value is optional.

# Pick one model provider for the Strands agent. With neither, the deterministic planner answers.
ANTHROPIC_API_KEY=
# AWS_REGION=us-west-2
# AWS_PROFILE=your-profile
# HOME_AHEAD_MODEL_ID=   # optional for Anthropic; required for Bedrock (a model ID or inference profile your account can invoke)

# HOME_AHEAD_AGENT=planner   # force the planner (or "bedrock" to force Bedrock)
# PORT=8787
# HOST=127.0.0.1
# HOME_AHEAD_DEMO=1          # simulated clock and demo household (npm run demo sets this)
# HOME_AHEAD_OFFLINE=1       # use the bundled CPSC snapshot only
# HOME_AHEAD_VIDEO_SAFE=1    # replace company names, emails and links in recall text
# HOME_AHEAD_STATE=data/state/household.json
# HOME_AHEAD_REFRESH_MINUTES=360
# HOME_AHEAD_TZ=America/Los_Angeles   # calendar time zone (default: this computer's zone; UTC in demo mode)
