{
  "name": "home-ahead",
  "version": "0.1.0",
  "description": "Home Ahead: an Alexa+ add-on (simulated) and MCP server that re-checks a home against real CPSC recalls as a child grows.",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "demo": "tsx --env-file-if-exists=.env src/main.ts --demo",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "video": "tsx video/make.ts"
  },
  "keywords": [
    "alexa-plus",
    "mcp",
    "mcp-apps",
    "cpsc",
    "recalls",
    "child-safety",
    "strands-agents"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@strands-agents/sdk": "^1.19.0",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
